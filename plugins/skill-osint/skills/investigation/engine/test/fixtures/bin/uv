#!/usr/bin/env node
// A stand-in for uv in the tests and the demo (OSINT_UV). It notes each call (OSINT_UV_LOG: one JSON line with argv,
// cwd and the environment keys that matter) and plays the GeoINT scripts from test/fixtures/geoint: each writes the
// files the real script writes, at the same paths, a little at a time so that progress can be seen. The case's
// picture stands in for every crop, sheet and screenshot. OSINT_FAKE_FAIL=<script> makes that script fail.
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const FX = path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'geoint')
const KEYS = ['GEMINI_API_KEY', 'GOOGLE_API_KEY', 'GOOGLE_APPLICATION_CREDENTIALS', 'GEOINT_CACHE', 'HF_HOME', 'TORCH_HOME', 'PLAYWRIGHT_BROWSERS_PATH', 'UV_CACHE_DIR', 'UV_PYTHON', 'UV_EXCLUDE_NEWER', 'GEOINT_PHOTOS', 'MAPILLARY_TOKEN', 'GEO_PROXY', 'PYTHONUTF8', 'UV']
const argv = process.argv.slice(2)
if (process.env.OSINT_UV_LOG) fs.appendFileSync(process.env.OSINT_UV_LOG, JSON.stringify({ argv, cwd: process.cwd(), env: Object.fromEntries(KEYS.filter(k => k in process.env).map(k => [k, process.env[k]])) }) + '\n')
const sleep = ms => new Promise(ok => setTimeout(ok, ms))
const flag = (args, name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined }
const flags = (args, name) => args.flatMap((a, i) => (a === name ? [args[i + 1]] : []))
const fx = rel => path.join(FX, rel)
const readFx = rel => JSON.parse(fs.readFileSync(fx(rel), 'utf8'))
const put = (to, from) => { fs.mkdirSync(path.dirname(to), { recursive: true }); fs.copyFileSync(from, to) }
const json = (to, v) => { fs.mkdirSync(path.dirname(to), { recursive: true }); fs.writeFileSync(to, JSON.stringify(v, null, 1)) }

if (argv[0] === '--version') { console.log('uv 0.9.7 (fake)'); process.exit(0) }
// uv tool run playwright install chromium
if (argv[0] === 'tool') { fs.mkdirSync(path.join(process.env.PLAYWRIGHT_BROWSERS_PATH, 'chromium-1200'), { recursive: true }); console.log('Chromium downloaded (fake)'); process.exit(0) }
// uv run [-q] <script.py | python -m unittest …> args
const rest = argv.slice(1).filter(a => a !== '-q'), at = rest.findIndex(a => a.endsWith('.py') || a === 'python')
const script = path.basename(rest[at] ?? ''), args = rest.slice(at + 1)
const failing = process.env.OSINT_FAKE_FAIL === script.replace(/\.py$/, '')
if (failing && script !== 'recon.py') { console.error(`${script}: a failure the test asked for`); process.exit(1) }

// the reverse search of one picture: what intake.py writes with revimg.py's results for Yandex and Baidu
function revFor(photo, out) {
  const stem = path.parse(photo).name, rev = path.join(out, 'rev')
  const y = { ...readFx('rev/yandex.json'), image: photo, screenshot: path.join(rev, `${stem}_yandex.png`) }
  const b = { ...readFx('rev/baidu.json'), image: photo, screenshot: path.join(rev, `${stem}_baidu.png`), similar_sheet: path.join(rev, `${stem}_baidu_similar.jpg`) }
  json(path.join(rev, `${stem}_yandex.json`), y)
  json(path.join(rev, `${stem}_baidu.json`), b)
  for (const f of [`${stem}_yandex.png`, `${stem}_baidu.png`, `${stem}_baidu_similar.jpg`]) put(path.join(rev, f), photo)
  const entry = (engine, d) => ({ variant: stem, engine, guess: d.guess, links: d.links.slice(0, 8), error: null, refused: false, shot: `${stem}_${engine}.png`, json: `${stem}_${engine}.json`,
    similar_n: (d.similar ?? []).length, similar_sites: (d.similar ?? []).map(s => [s.site, 1]), similar_sheet: engine === 'baidu' ? `${stem}_baidu_similar.jpg` : null, similar_note: null })
  json(path.join(out, 'intake.json'), { photo, exif: {}, ocr: [], rev: [entry('yandex', y), entry('baidu', b)], votes: readFx('rev/votes.json'), status: { 'rev-yandex': 'ok', 'rev-baidu': 'ok' }, timings: {}, compare: '' })
}

switch (script) {
  case 'recon.py': {
    const photo = path.resolve(args[0]), out = path.resolve(flag(args, '--out-dir') ?? 'recon'), noMl = args.includes('--no-ml')
    const steps = ['meta', 'intake', 'textgeo.json', ...(noMl ? [] : ['detect', 'calib.json', 'prior'])]
    fs.mkdirSync(out, { recursive: true })
    for (const s of steps) {
      await sleep(30)
      if (failing && s === 'detect') { console.error('detect.py: RuntimeError: CUDA out of memory'); process.exit(1) }
      fs.cpSync(fx(`recon/${s}`), path.join(out, s), { recursive: true })
    }
    // the real recon.py runs intake.py's Yandex and Baidu search unless --no-rev
    if (!args.includes('--no-rev')) revFor(photo, path.join(out, 'intake'))
    put(path.join(out, 'intake', 'ocr.png'), photo)
    if (!noMl) for (const c of ['detect/01_sign.jpg', 'detect/02_pole.jpg', 'detect/detect_sheet.jpg', 'calib.jpg']) put(path.join(out, c), photo)
    fs.writeFileSync(path.join(out, 'recon.md'), `# Recon: ${path.basename(photo)}\n\nFake first pass (test/fixtures/bin/uv).\n`)
    json(path.join(out, 'recon.json'), { photo, steps: Object.fromEntries(steps.map(s => [s.replace('.json', ''), { rc: 0, seconds: 0.1, error: '', stdout_tail: '' }])) })
    break
  }
  case 'intake.py': if (!args.includes('--no-rev')) revFor(path.resolve(args[0]), path.resolve(flag(args, '--out-dir'))); break
  case 'compare.py': {
    const root = path.resolve(flag(args, '--root') ?? '.'), out = path.resolve(flag(args, '--out-dir') ?? path.join(root, 'compare')), q = flags(args, '--query')[0]
    const c = readFx('compare/compare.json')
    if (q) for (const k of c.candidates) if (k.file) put(path.join(root, k.file), q)
    json(path.join(out, 'compare.json'), { ...c, root, no_check: args.includes('--no-check') })
    fs.writeFileSync(path.join(out, 'compare.md'), '# Compare\n\nFake ranking.\n')
    if (q) put(path.join(out, 'sheet.jpg'), q)
    console.log(`compare: ${c.candidates.length} candidates from ${c.n_lists} lists (fake); Gemini ${args.includes('--no-check') ? 'not run' : 'WOULD RUN'}`)
    break
  }
  case 'detect.py': json(path.join(path.resolve(flag(args, '--out-dir') ?? 'detect'), 'detect.json'), { ...readFx('people/detect.json'), image: args[0] }); break
  case 'imgprep.py': if (args[0] === 'mask') put(path.resolve(flag(args, '--out')), path.resolve(args[1])); break
  case 'sweep.py': {
    if (args[0] === 'index') {
      const name = flag(args, '--name') ?? path.parse(flag(args, '--manifest')).name
      console.log(`index ${name}: 512 panoramas in the manifest, 0 already indexed, 512 to do -> ${process.env.GEOINT_CACHE}/sweep/${name}`)
      for (const n of [256, 512]) { await sleep(30); console.log(`  ${n}/512 panoramas, ${n * 8} views, ${n / 20}s${n < 512 ? ', ~0.2 min left' : ''}`) }
      console.log(`done: 512 panoramas, 4096 views in ${process.env.GEOINT_CACHE}/sweep/${name}`)
    } else if (args[0] === 'rank') {
      const out = path.resolve(flag(args, '--out-dir') ?? 'sweep')
      for (const f of ['ranked.json', 'clusters.json']) put(path.join(out, f), fx(`sweep/${f}`))
      put(path.join(out, 'top.jpg'), path.resolve(flag(args, '--query')))
      console.log('3 panoramas ranked (fake)')
    }
    break
  }
  case 'pano.py': {
    const out = path.resolve(flag(args, '--out'))
    if (args[0] === 'coverage') put(out, fx('pano/coverage.json'))
    if (args[0] === 'list') { const p = flag(args, '--provider'), from = fx(`pano/${p}.jsonl`); fs.mkdirSync(path.dirname(out), { recursive: true }); fs.writeFileSync(out, fs.existsSync(from) ? fs.readFileSync(from) : ''); console.log(`${p}: listed (fake) -> ${out}`) }
    break
  }
  case 'revimg.py': {
    // <stem>_<engine>.json and .png for each image and engine (rev/<name>_<engine>.json when the test gives one for
    // that picture, else rev/<engine>.json), and Baidu's similar-images sheet, as revimg.py writes them
    const out = path.resolve(flag(args, '--out-dir') ?? 'rev'), engines = (flag(args, '--engines') ?? 'baidu,yandex').split(',')
    for (const img of args.filter(a => /\.(jpe?g|png|webp|gif)$/i.test(a))) {
      const stem = path.parse(img).name, name = stem.replace(/^E\d+-/, '')
      for (const eng of engines) {
        const own = fx(`rev/${name}_${eng}.json`), d = JSON.parse(fs.readFileSync(fs.existsSync(own) ? own : fx(`rev/${eng}.json`), 'utf8'))
        const res = { ...d, image: img, engine: eng, screenshot: path.join(out, `${stem}_${eng}.png`) }
        put(res.screenshot, img)
        if (eng === 'baidu' && (d.similar ?? []).length) { res.similar_sheet = path.join(out, `${stem}_baidu_similar.jpg`); put(res.similar_sheet, img) }
        json(path.join(out, `${stem}_${eng}.json`), res)
      }
      console.log(`${stem}: ${engines.join(', ')} (fake)`)
    }
    break
  }
  case 'doctor.py':
    console.log(args.includes('--json') ? JSON.stringify({ ok: true, connection: 'direct', checks: ['prior.py models', 'detect.py model', 'calib.py model', 'sweep.py MegaLoc'].map(name => ({ name, status: 'PASS', detail: 'Loaded and ran on a synthetic image.', fix: '' })) }) : '[PASS] prior.py models: Loaded and ran on a synthetic image.')
    break
  case 'python': case 'test_tools.py': case 'test_runtime.py': console.log('OK (fake)'); break
  default: json(path.join(process.cwd(), `out-${script.replace(/\.py$/, '')}.json`), { script, args }); console.log(`${script} ok (fake)`)
}
